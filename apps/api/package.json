    "jose": "^5.3.0",
    "pg": "^8.11.0",
    "undici": "^6.17.0",
    "zod": "^3.23.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.9.0",
    "typescript": "*",
    "vitest": "^1.5.0"
  }
