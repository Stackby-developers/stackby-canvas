{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@stackby/schema-types": ["./packages/schema-types/src/index.ts"],
      "@stackby/studio-sdk": ["./packages/sdk/src/index.ts"],
      "@stackby/prompts": ["./packages/prompts/src/index.ts"],
      "@stackby/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "**/dist/**", "**/.next/**"]
}
